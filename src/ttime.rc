// Windows resources for tTime.exe: icon and version information (file properties
// in Explorer). Keep the version in step with VERSION in common.pri.
#include <winver.h>

IDI_ICON1 ICON DISCARDABLE "Resources/icons/alarm.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,2,3,0
PRODUCTVERSION  0,2,3,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Vladimir Gjokjevski\0"
            VALUE "FileDescription",  "tTime - countdown alarms in the system tray\0"
            VALUE "FileVersion",      "0.2.3\0"
            VALUE "InternalName",     "tTime\0"
            VALUE "LegalCopyright",   "Copyright (c) 2010-2026 Vladimir Gjokjevski. MIT License.\0"
            VALUE "OriginalFilename", "tTime.exe\0"
            VALUE "ProductName",      "tTime\0"
            VALUE "ProductVersion",   "0.2.3\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
