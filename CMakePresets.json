{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/dist/${presetName}"
    },
    {
      "name": "windows-mingw",
      "hidden": true,
      "inherits": "base",
      "description": "Qt 6.12 + MinGW 13.1 as installed by the Qt online installer under %QT_ROOT% (e.g. C:\\Qt)",
      "condition": {
        "type": "allOf",
        "conditions": [
          { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
          { "type": "notEquals", "lhs": "$penv{QT_ROOT}", "rhs": "" }
        ]
      },
      "environment": {
        "QT_DIR_MINGW": "$penv{QT_ROOT}/6.12.0/mingw_64",
        "PATH": "$penv{QT_ROOT}/Tools/mingw1310_64/bin;$penv{QT_ROOT}/Tools/Ninja;$env{QT_DIR_MINGW}/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_DIR_MINGW}",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "mingw-debug",
      "displayName": "Qt 6.12 MinGW 64-bit - Debug (needs QT_ROOT)",
      "inherits": "windows-mingw",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "mingw-release",
      "displayName": "Qt 6.12 MinGW 64-bit - Release (needs QT_ROOT)",
      "inherits": "windows-mingw",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "mingw-release-static",
      "displayName": "Qt 6.12 MinGW 64-bit - Release, static Qt (needs QT_ROOT and scripts/build-static-qt.ps1)",
      "inherits": "windows-mingw",
      "environment": {
        "QT_DIR_MINGW": "$penv{QT_ROOT}/6.12.0/mingw_64_static"
      },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "default",
      "displayName": "Qt found via CMAKE_PREFIX_PATH / PATH (any platform)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    }
  ],
  "buildPresets": [
    { "name": "mingw-debug", "configurePreset": "mingw-debug" },
    { "name": "mingw-release", "configurePreset": "mingw-release" },
    { "name": "mingw-release-static", "configurePreset": "mingw-release-static" },
    { "name": "default", "configurePreset": "default" }
  ],
  "testPresets": [
    { "name": "mingw-debug", "configurePreset": "mingw-debug", "output": { "outputOnFailure": true } },
    { "name": "mingw-release", "configurePreset": "mingw-release", "output": { "outputOnFailure": true } },
    { "name": "mingw-release-static", "configurePreset": "mingw-release-static", "output": { "outputOnFailure": true } },
    { "name": "default", "configurePreset": "default", "output": { "outputOnFailure": true } }
  ]
}
